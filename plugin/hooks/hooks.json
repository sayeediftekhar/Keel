{
  "description": "Keel v3 gates: block pushes to protected branches, immediate merges and PR self-approvals, unapproved live migrations, credential reads, governance-file edits and production deploys. Each gate fails closed. After a file write, the project's formatter runs (never blocks).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugin/hooks/gate.mjs\"", "timeout": 30, "onFailure": "block" }]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugin/hooks/gate.mjs\"", "timeout": 30, "onFailure": "block" }]
      },
      {
        "matcher": "^mcp__.*__(merge_pull_request|push_files|create_or_update_file|delete_file|apply_migration|execute_sql|merge_branch|deploy_edge_function|actions_run_trigger)$",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugin/hooks/gate.mjs\"", "timeout": 30, "onFailure": "block" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugin/hooks/format.mjs\"", "timeout": 30 }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugin/hooks/receipt.mjs\"", "timeout": 15 }]
      },
      {
        "matcher": "^mcp__.*__apply_migration$",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugin/hooks/receipt.mjs\"", "timeout": 15 }]
      }
    ]
  }
}
