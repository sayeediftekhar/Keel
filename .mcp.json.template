{
  "$comment": "Keel MCP connector template. Copy to .mcp.json and fill the ${ENV} values (never commit real secrets — .mcp.json should be gitignored). Delete the servers you don't use; each loads tools into every session. URLs/commands below reflect each vendor's documented setup and may change — check the source repo in catalog.md. SUPPLY CHAIN: `npx -y <pkg>` runs whatever version npm serves today; pin each package (`<pkg>@<version>`) once you have verified it, like the manifest pins git upstreams.",
  "mcpServers": {
    "slack": {
      "command": "npx",
      "args": ["-y", "@slack/mcp-server"],
      "env": { "SLACK_MCP_XOXP_TOKEN": "${SLACK_MCP_XOXP_TOKEN}" }
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": { "NOTION_TOKEN": "${NOTION_TOKEN}" }
    },
    "zapier": {
      "type": "http",
      "url": "https://mcp.zapier.com/api/mcp/mcp",
      "headers": { "Authorization": "Bearer ${ZAPIER_MCP_KEY}" }
    },
    "perplexity": {
      "command": "npx",
      "args": ["-y", "@perplexity-ai/mcp-server"],
      "env": { "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}" }
    },
    "granola": {
      "$note": "Granola's official MCP is a hosted connector — set up via granola.ai. Community stdio servers (e.g. chrisguillory/granola-mcp) are third-party; vet before use.",
      "type": "http",
      "url": "${GRANOLA_MCP_URL}"
    },
    "higgsfield": {
      "$note": "Hosted generative MCP — configure via higgsfield.ai/mcp.",
      "type": "http",
      "url": "${HIGGSFIELD_MCP_URL}",
      "headers": { "Authorization": "Bearer ${HIGGSFIELD_API_KEY}" }
    },
    "kondo": {
      "$note": "Requires the Kondo browser extension + account (Business tier). Configure via docs.trykondo.com/mcp-setup.",
      "type": "http",
      "url": "${KONDO_MCP_URL}"
    },
    "sentry": {
      "$note": "Sentry's hosted MCP — OAuth on first connect, so no token lives here. Scope it to one project. Same as: claude mcp add --transport http --scope project sentry <url>. (agent-browser is used as a CLI from the shell instead of an MCP server — no per-session tool cost.)",
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp/${SENTRY_ORG}/${SENTRY_PROJECT}"
    }
  }
}
